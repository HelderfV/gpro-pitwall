{% import "partials/_localtime.twig" as t %}
<div class="mb-4 rounded-md bg-amber-50 border-l-4 border-amber-400 p-4 shadow-sm">
    <p class="text-sm text-amber-800">
        <span class="font-bold">Changed the car?</span>
        Re-sync first — these projections use your last-synced car data{% if user.last_synced_at %} (last sync: {{ t.localtime(user.last_synced_at, 'datetime') }}){% endif %}.
    </p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

    {# LEFT: Controls #}
    <div class="lg:col-span-4">
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200 bg-slate-50">
                <h3 class="t-heading">Race Analysis</h3>
            </div>

            <div class="p-6">
                {% if wear_error == no_pilot_message %}
                    <div class="mb-4">{% include 'partials/_no_pilot_notice.twig' %}</div>
                {% elseif wear_error %}
                    <div class="mb-4 notice notice-error">
                        {{ wear_error }}
                    </div>
                {% endif %}

                <form method="POST" action="/calculate_wear" id="wearForm">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

                    {# Driver Stats Section — read-only, fetched from the GPRO API. #}
                    <div class="mb-6 p-4 bg-slate-50 rounded-lg border border-slate-100">
                        <div class="flex items-baseline justify-between mb-3">
                            <h4 class="t-section">Driver Stats</h4>
                        </div>
                        {% if wear_inputs.driver is defined %}
                            <div class="grid grid-cols-3 gap-3">
                                <div>
                                    <span class="t-label block mb-1">Concentration</span>
                                    <span class="t-value block">{{ wear_inputs.driver.concentration }}</span>
                                </div>
                                <div>
                                    <span class="t-label block mb-1">Talent</span>
                                    <span class="t-value block">{{ wear_inputs.driver.talent }}</span>
                                </div>
                                <div>
                                    <span class="t-label block mb-1">Experience</span>
                                    <span class="t-value block">{{ wear_inputs.driver.experience }}</span>
                                </div>
                            </div>
                        {% else %}
                            <p class="t-caption">No driver data — sync your account first.</p>
                        {% endif %}
                    </div>

                    <div class="mb-6">
                        <label class="t-label block mb-2">Clear Track Risk</label>
                        <div class="flex items-center gap-4">
                            <input type="range" name="risk" min="0" max="100" value="{{ wear_inputs.risk ?? 0 }}"
                                   data-wear-risk-slider
                                   class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer"
                                   >
                            <span id="riskVal" class="text-sm font-bold text-blue-600 w-8 tabular-nums">{{ wear_inputs.risk ?? 0 }}</span>
                        </div>
                        <p class="t-caption mt-2">Move the slider — projection refreshes automatically.</p>
                    </div>

                    {% if wear_part_choices is defined and wear_part_choices %}
                        <div class="mb-6">
                            <div class="flex items-baseline justify-between mb-3">
                                <h4 class="t-section">Car Parts</h4>
                            </div>
                            <div class="space-y-3">
                                {% for slug, part in wear_part_choices %}
                                    <div class="rounded-md border border-slate-200 p-3 bg-white"
                                         data-wear-part
                                         data-has-old="{{ part.old_options ? '1' : '0' }}">
                                        <label for="wear_{{ slug }}_choice" class="t-label block mb-1">{{ part.label }}</label>
                                        <select id="wear_{{ slug }}_choice"
                                                name="parts[{{ slug }}][choice]"
                                                data-wear-part-choice
                                                class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700">
                                            {% for option in part.choices %}
                                                <option value="{{ option.value }}" {{ option.value == part.selected_choice ? 'selected' : '' }}>
                                                    {{ option.label }}
                                                </option>
                                            {% endfor %}
                                        </select>

                                        <div class="mt-2 grid grid-cols-2 gap-2 {{ part.show_manual ? '' : 'hidden' }}"
                                             data-wear-manual-fields>
                                            <label class="block">
                                                <span class="t-label block mb-1">Level</span>
                                                <input type="number"
                                                       name="parts[{{ slug }}][manual_level]"
                                                       min="1"
                                                       max="9"
                                                       value="{{ part.manual_level }}"
                                                       data-wear-manual-input
                                                       class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm tabular-nums">
                                            </label>
                                            <label class="block">
                                                <span class="t-label block mb-1">Wear %</span>
                                                <input type="number"
                                                       name="parts[{{ slug }}][manual_wear]"
                                                       min="0"
                                                       max="100"
                                                       value="{{ part.manual_wear }}"
                                                       data-wear-manual-input
                                                       class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm tabular-nums">
                                            </label>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                </form>
            </div>

            <div class="bg-slate-50 px-6 py-4 border-t border-slate-200 t-caption">
                <p>Calculates wear based on Track Characteristics, Car Level, and Driver Stats.</p>
            </div>
        </div>
    </div>

    {# RIGHT: Results (live-refreshed when wear inputs change) #}
    <div class="lg:col-span-8" id="wear-results-card">
        {% include 'partials/_car_wear_results.twig' %}
    </div>
</div>

<script>
(() => {
    const slider = document.querySelector('[data-wear-risk-slider]');
    const card = document.getElementById('wear-results-card');
    const form = document.getElementById('wearForm');
    if (!slider || !card || !form) return;

    let pending = null;
    let debounce = null;

    const refresh = async () => {
        if (pending) pending.abort();
        pending = new AbortController();
        const data = new FormData(form);
        try {
            const res = await fetch('/car_wear_fragment', {
                method: 'POST',
                body: data,
                signal: pending.signal,
                headers: { 'X-Requested-With': 'fetch' },
            });
            if (!res.ok) return;
            card.innerHTML = await res.text();
        } catch (err) {
            if (err.name !== 'AbortError') console.error(err);
        }
    };

    const queueRefresh = () => {
        window.clearTimeout(debounce);
        debounce = window.setTimeout(refresh, 250);
    };

    const updateManualVisibility = (part) => {
        if (!(part instanceof HTMLElement)) return;
        const select = part.querySelector('[data-wear-part-choice]');
        const manual = part.querySelector('[data-wear-manual-fields]');
        if (!(select instanceof HTMLSelectElement) || !(manual instanceof HTMLElement)) return;

        const show = select.value === 'manual' || part.dataset.hasOld === '0';
        manual.classList.toggle('hidden', !show);
    };

    form.querySelectorAll('[data-wear-part]').forEach(updateManualVisibility);

    form.addEventListener('input', (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;

        if (target.matches('[data-wear-risk-slider]') && target instanceof HTMLInputElement) {
            const riskVal = document.getElementById('riskVal');
            if (riskVal) riskVal.innerText = target.value;
            queueRefresh();
            return;
        }

        if (target.matches('[data-wear-manual-input]')) {
            const part = target.closest('[data-wear-part]');
            const select = part ? part.querySelector('[data-wear-part-choice]') : null;
            if (select instanceof HTMLSelectElement) {
                select.value = 'manual';
                updateManualVisibility(part);
            }
            queueRefresh();
        }
    });

    form.addEventListener('change', (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;

        const part = target.closest('[data-wear-part]');
        if (part && target.matches('[data-wear-part-choice]')) {
            updateManualVisibility(part);
            queueRefresh();
            return;
        }

        if (target.matches('[data-wear-risk-slider], [data-wear-manual-input]')) {
            queueRefresh();
        }
    });
})();
</script>
